{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://connect-m1wh.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*).woff2",
      "headers": [
        { "key": "Content-Type", "value": "font/woff2" }
      ]
    },
    {
      "source": "/assets/(.*).woff",
      "headers": [
        { "key": "Content-Type", "value": "font/woff" }
      ]
    },
    {
      "source": "/assets/(.*).ttf",
      "headers": [
        { "key": "Content-Type", "value": "font/ttf" }
      ]
    }
  ]
}
