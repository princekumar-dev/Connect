{
  "name": "msec-connect",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm exec vite build && echo 'Build completed successfully'",
    "preview": "npm exec vite preview",
    "server": "node server.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "warm-tunnel": "node scripts/warm-tunnel.js",
    "dev:warm": "concurrently \"npm run server\" \"npm run dev\" \"npm run warm-tunnel\"",
    "clean": "rmdir /s /q dist 2>nul || echo \"Directory already clean\"",
    "prebuild": "npm run clean",
    "generate-vapid": "node generate-vapid-keys.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "ical-generator": "^9.0.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.2.7",
    "moment": "^2.30.1",
    "mongoose": "^8.23.0",
    "node-cron": "^4.2.1",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.3.1",
    "react-photo-view": "^1.2.7",
    "react-router-dom": "^7.14.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^7.6.0",
    "postcss": "^8.5.8",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.3"
  }
}
